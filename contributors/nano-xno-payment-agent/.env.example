# Nano XNO Payment Agent — environment variables
#
# Required:
# AGENT_SEED_PHRASE=your_agent_seed
# AGENT_PORT=8000
#
# Nano: the receiving Nano account. This is the account the buyer must send XNO
# to. You control the corresponding seed (via a Nano wallet / feeless402 / etc.).
# NANO_ACCOUNT=nano_1...your_nano_receiving_address
#
# ASI:One API key (if you want LLM processing after payment):
# ASI_ONE_API_KEY=your_asi_one_api_key_here
NANO_AMOUNT=0.0001
AGENT_NAME=nano-xno-payment-agent
AGENT_SEED_PHRASE=nano-xno-payment-agent-seed
AGENT_PORT=8000