# battle.training account key — required ONLY for --mode full
# (create_bot / upload_version / scrimmage / enrol_ladder).
# Get one by creating an account: via the MCP server's create_account tool,
# or at https://battle.training (claim the account to keep the key safe).
# Demo mode works without a key. NEVER commit a real key.
BATTLE_TRAINING_API_KEY=

# Default bot name used by --mode full (3-32 chars). The agent creates it
# if it does not exist yet, or reuses it if you already own it.
BATTLE_TRAINING_BOT_NAME=
